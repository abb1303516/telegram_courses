# === Telegram API ===
# Get at https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here
PHONE=+79001234567

# === Web interface ===
SECRET_KEY=change-this-to-random-string
APP_PASSWORD=mypassword123
HOST=127.0.0.1
PORT=8080

# === Storage ===
DOWNLOAD_DIR=./downloads

# === Reverse proxy prefix (e.g. /tg) ===
URL_PREFIX=/tg

# === Parallel download of large files (optional) ===
# Separate connections per file: 4 measured as ~2x faster, near the
# non-premium ceiling of ~10 MB/s. 1 = old single-stream download.
# Opening connections takes ~1.5 s each, so smaller files go single-stream.
# DOWNLOAD_CONNECTIONS=4
# PARALLEL_MIN_MB=60

# === Proxy for Telegram connection (optional) ===
# PROXY=http://host:port
# PROXY=socks5://user:pass@host:port
